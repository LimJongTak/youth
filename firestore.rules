rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'admin';
    }

    // Cohort (기수) data: the public site only ever reads this collection,
    // so reads are open to anyone. Both admins and managers may edit
    // cohort content.
    match /cohorts/{cohortId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Editable page copy (hero text, about, checklist, tracks, benefits,
    // journey, FAQ, contact info) — same public-read / signed-in-write
    // shape as cohorts, so any logged-in admin or manager can edit any
    // part of the page.
    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Cohort training schedule (class sessions / general events). Same
    // public-read / signed-in-write shape as cohorts — the public site
    // reads the calendar, only a signed-in admin/manager edits it.
    match /schedules/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Account profiles (role assignment). A signed-in user may read the
    // list (needed for the admin's account-management screen and for
    // looking up their own role). A brand-new account may create its own
    // profile doc once (the bootstrap case, right after Auth sign-up);
    // after that, only an existing admin may create/update/delete other
    // accounts' profiles.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if isAdmin();
    }

    // First-party analytics events (page views, apply/kakao clicks). Any
    // visitor (including anonymous) may log an event; only signed-in
    // admins/managers can read the log back (admin "통계" tab), and it is
    // append-only — no client may edit or delete past entries.
    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    // Audit trail of content saves (who changed which section, when).
    // Same shape as analytics: append-only, readable by signed-in
    // admins/managers, writable only by a signed-in user for their own uid.
    match /auditLog/{entryId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
